# CPU configuration: size to your container CPU quota, then benchmark.
# Defaults retain the single-process layout; TTS admission stays bounded at 4.
VOICE_ASR_WORKERS=1
VOICE_TTS_WORKERS=1
VOICE_ASR_THREADS=2
VOICE_TTS_THREADS=2
VOICE_ORT_SPINNING=1
