# Optional pinned revisions. The defaults point at the verified public artifacts.
MATCHA_REPO=duyleekun/matcha-vi-en
MATCHA_REVISION=main
ASR_REPO=g-group-ai-lab/gipformer1.5-68M-rnnt
ASR_REVISION=dd9227dcd8705c13f33bdbe59728d546ab94480f

# CPU configuration: size to your container CPU quota, then benchmark.
# Defaults retain the single-process layout; TTS admission stays bounded at 4.
VOICE_ASR_WORKERS=1
VOICE_TTS_WORKERS=1
VOICE_ASR_THREADS=2
VOICE_TTS_THREADS=2
# Applies to VAD/TTS ONNX sessions; native Sherpa ASR creates its own sessions.
VOICE_ORT_SPINNING=1

# Split serving is opt-in. All remains the compatibility default.
VOICE_ROLE=all
# Per split worker: total admitted jobs (running + waiting); queue deadline stays 2s.
VOICE_STT_ADMISSION=2
VOICE_TTS_ADMISSION=2
# Raise only after a measured gateway capacity test (maximum 256).
VOICE_GATEWAY_MAX_MICROPHONES=32
# Required for gateway/stt/tts; inject from a Secret, never commit real values.
# VOICE_RPC_TOKEN=
# Docker-only gateway routing (Kubernetes uses namespace EndpointSlices):
# VOICE_STT_URLS=http://stt:8765
# VOICE_TTS_URLS=http://tts:8765
