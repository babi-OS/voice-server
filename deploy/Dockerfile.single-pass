# Preserve the exact native dependencies used in matched local benchmarks.
FROM ghcr.io/babi-os/voice-server:0.0.2@sha256:fe9623ebd5a37dbaef6019c465fedda87804992dd141b23baa5653030f8e7a71
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --chown=10001:10001 voice_server /app/voice_server
COPY --chown=10001:10001 model /opt/voice-models/single-pass
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VOICE_ORT_SPINNING=0 MATCHA_CPU_DIR=/opt/voice-models/single-pass
CMD ["/app/.venv/bin/python","-m","voice_server.stack"]
